#--[ Единый стиль форматирования проекта ]--#
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,json,jsonc,md}]
indent_style = space
indent_size = 2

#--[ В markdown хвостовые пробелы не трогаем ]--#
[*.md]
trim_trailing_whitespace = false
